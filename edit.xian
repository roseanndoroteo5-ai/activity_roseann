<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Employee</title>
</head>
<body>
    <h2>Edit Employee Record</h2>
    <form action="/employees/{{data.id}}" method="POST">
    <input type="text" name="FirstName" value="{{data.FirstName}}" required>
    <input type="text" name="LastName" value="{{data.LastName}}" required>
    <input type="text" name="Position" value="{{data.Position}}">
    <input type="text" name="Department" value="{{data.Department}}">
    <input type="number" name="Salary" value="{{data.Salary}}">
    <input type="date" name="DateHired" value="{{data.DateHired}}">
    <button type="submit">
</form>